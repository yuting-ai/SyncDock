      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        }
      }
    },
    "在目标里新建「%@」文件夹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a “%@” folder in the destination"
          }
        }
      }
    },
    "复制失败：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not copy: %@"
          }
        }
      }
    },
    "完全磁盘访问权限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access"
          }
        }
      }
    },
    "完成，但有警告": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished with warnings"
          }
        }
      }
    },
    "定时同步在后台运行，没人能点「允许」，所以要提前授权，SyncDock 才能读取桌面、文稿和移动硬盘。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled syncs run in the background, where nobody can click “Allow”. Grant access in advance so SyncDock can read your Desktop, Documents and external drives."
          }
        }
      }
    },
    "已 %lld 天未同步": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Not synced for %lld day"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Not synced for %lld days"
                }
              }
            }
          }
        }
      }
    },
    "已开启": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted"
          }
        }
      }
    },
    "已确认 SyncDock 拥有「完全磁盘访问权限」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed: SyncDock has Full Disk Access."
          }
        }
      }
    },
    "已经有同名的任务了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task with this name already exists"
          }
        }
      }
    },
