            "value": "Tasks and sync history"
          }
        }
      }
    },
    "任务运行后，每次同步的结果都会显示在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each sync will show up here after the task runs."
          }
        }
      }
    },
    "但保留 .git 文件夹（Git 仓库的历史记录）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "But keep .git folders (Git repository history)"
          }
        }
      }
    },
    "例如：论文-移动硬盘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
